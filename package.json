{
  "name": "group-scheduler",
  "version": "0.1.0",
  "description": "Availability polling, conflict-free group session timetabling (custom branch-and-bound) and a presence board on Cloudflare Workers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm cf-typegen && tsc -b",
    "test": "pnpm cf-typegen && vitest run"
  },
  "packageManager": "pnpm@11.12.0",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "~1.4.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.0",
    "vite": "~8.3.4",
    "vitest": "^4.1.8",
    "wrangler": "~4.151.2"
  }
}
